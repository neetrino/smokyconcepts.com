{
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=@shop/web",
  "devCommand": "npm run dev --workspace=@shop/web",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "apps/web/app/api/v1/admin/products/route.ts": {
      "maxDuration": 30
    },
    "apps/web/app/api/v1/admin/products/upload-images/route.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
